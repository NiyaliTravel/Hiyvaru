# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — real secrets never leave this machine.
# .env.example IS committed on purpose: it documents required config for
# contributors and must contain blank values only.
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# hiyvaru local data (PGlite, mock SMS outbox, cookies)
.data/
.env
drizzle/meta/_journal.json.bak

# Capacitor native projects (regenerate with: npx cap add ios|android)
/ios/
/android/
